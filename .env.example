# Copie este arquivo para .env e preencha. Nunca publique o .env.

# Voz (escolha um provedor no YAML de cada marca)
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Vídeos de fundo (pexels.com/api, grátis)
PEXELS_API_KEY=

# Meta (Instagram + Página do Facebook), um token só por marca.
# Token do usuário do sistema: Configurações do negócio > Usuários do sistema > Gerar token, validade
# "Nunca", com instagram_basic, instagram_content_publish, instagram_manage_insights,
# instagram_manage_comments, pages_show_list, pages_read_engagement, pages_manage_posts,
# pages_manage_metadata e business_management. O kit descobre a conta do Instagram pela Página e usa a
# Página para dar link público aos slides do carrossel (fotos não publicadas, apagadas depois).
# Mais fácil: rode scripts/configurar_meta.ps1, que pede o token sem mostrá-lo e preenche aqui.
# Confira com: paginas meta conferir --marca gg_explica
GRAPH_API_VERSION=v26.0
META_TOKEN_GG_EXPLICA=
FB_PAGE_ID_GG_EXPLICA=1368551089682268
META_TOKEN_SEUL_NO_BOLSO=
FB_PAGE_ID_SEUL_NO_BOLSO=
META_TOKEN_GG_EXPLICA_ES=
FB_PAGE_ID_GG_EXPLICA_ES=
# Formato antigo (ainda aceito, tem prioridade): IG_USER_ID_<MARCA>, IG_TOKEN_<MARCA>, FB_PAGE_TOKEN_<MARCA>

# YouTube Shorts (opcional): cliente OAuth "App para computador" no Google Cloud com a YouTube Data
# API v3 ativada. O refresh token de cada canal sai do `paginas youtube autorizar --marca gg_explica`.
# Deixe a tela de consentimento OAuth "Em produção" (em teste, o acesso vence em 7 dias); no aviso de
# app não verificado, clique em Avançado e continue (o app é seu).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN_GG_EXPLICA=
YT_REFRESH_TOKEN_GG_EXPLICA_ES=

# Aprovação pelo celular (Telegram): crie o bot com o @BotFather, mande um "oi" para ele e rode
# `paginas telegram teste` para descobrir o seu chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
